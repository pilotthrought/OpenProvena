# ============================================
# OpenProvena Environment Variables
# Copiez ce fichier en .env et configurez les valeurs
# ============================================

# === Application ===
APP_NAME=OpenProvena
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-in-production-use-a-long-random-string

# === Serveur ===
HOST=0.0.0.0
PORT=8000
WORKERS=4

# === Base de données PostgreSQL ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openprovena

# === Neo4j (Knowledge Graph) ===
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Elasticsearch ===
ELASTICSEARCH_URL=http://localhost:9200

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === JWT / Authentification ===
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS ===
CORS_ORIGINS=http://localhost:3000,https://openprovena.org

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# === ML/NLP ===
MODEL_CACHE_DIR=./models
DEVICE=cpu

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
